#!/usr/bin/env python3
"""Build this board in a patched cache; leave the upstream checkout unchanged."""
import hashlib
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

DEVICE = Path(__file__).resolve().parent
UPSTREAM = 'https://github.com/UniXNU/UniXNU.git'


def prepare(device=DEVICE, source=None):
    revision = (device / 'upstream.rev').read_text().strip()
    if not re.fullmatch('[0-9a-f]{40}', revision):
        raise ValueError('upstream.rev must contain a full Git commit ID')
    # No engine-source fork any more. Up to v185 this repository carried
    # patches/unixnu-source-kernel.patch, a 4637-line diff over the whole engine
    # (docs, workflows, build scripts and the kernel hooks that called this board).
    # That only ever applied to the revision it was cut against, and the migration
    # to 6790e7c moves 461 commits ahead of it. The newer engine does the same job
    # natively: a board ships patches/xnu/*.patch named by patches/xnu/series, and
    # the late probe hook this board used is now a supported extension point.
    patch = device / 'patches/unixnu-source-kernel.patch'
    # Board components (UFS, display, panel, input, power, probes) are no longer
    # patches over engine submodules. They are real directories under drivers/ in
    # this repository, which components.py resolve() prefers over the catalog's
    # git source. Only the GPU stays a patch, because the A830 backend is not in
    # the Adreno740 revision the engine pins.
    driver_patches = [(device / 'patches' / name, module) for name, module in (
        # The whole A830 backend, taken from the OnePlus 13T port: CP init and its
        # self-test, the GPU/GMU SMMU contexts with the A830 address layout, the
        # A830 register bring-up (NativeAdrenoA830HwInit), the ring with gen8
        # fences, preemption, the published user client, and the ABI v2 the Metal
        # frontend speaks.
        ('adreno-a830.patch', 'Adreno740'),)]
    # Adreno740 is pinned by the engine at exactly the revision this patch is cut
    # against (a9a2cbb), so only AdrenoMetal needs moving: the Metal plugin inside
    # the reused Data volume was built against this fork revision, and the kernel
    # side has to publish the same ABI for it to load.
    driver_revisions = {
        'Adreno740': 'a9a2cbb43b89d672e2921e19721a6438b738b17f',
        'AdrenoMetal': '831a9dcbd6ac7de89a11bdaf031e07b9aadfa3c8',
    }
    # Kit patches land in kits/<module>, not drivers/<module>. The HFI kit as pinned
    # only speaks the A6xx/A7xx performance table; gen8 moved it to message 15 with
    # per-level dependent votes, and an A8XX configuration cannot even be validated
    # without it. hummer's GPU is an A830, so the kit learns the A8xx layout here.
    kit_patches = [(device / 'patches' / name, module) for name, module in (
        ('adreno-firmware-a8xx.patch', 'AdrenoFirmware'),)]
    # Everything that ends up inside the built kernel decides this fingerprint. `package/`
    # becomes kits/<board.kit> and `scripts/` holds the recipes that compile it, so a change
    # to either one produces a different payload. Leaving them out meant "only edit a driver"
    # hit the cache and reused the previous tree - v127c shipped the exact machine code of
    # v127b, down to the same pc and far, because the tree was never rebuilt.
    digest = hashlib.sha256(patch.read_bytes() if patch.is_file() else b'no-engine-fork')
    digest.update(repr(sorted(driver_revisions.items())).encode())
    for path, _ in driver_patches + kit_patches:
        if path.is_file():
            digest.update(path.read_bytes())
    # Board driver sources live in this repository now, so they decide the tree too.
    for source in sorted((device / 'drivers').rglob('*')):
        if source.is_file():
            digest.update(str(source.relative_to(device)).encode())
            digest.update(source.read_bytes())
    # The recipe decides what the tree contains, so it has to be hashed too.
    # Without this a change to prepare() -- moving a submodule, ordering a
    # patch -- left the fingerprint alone and CI restored the tree the old
    # recipe had built, dirty submodule and all.
    for name in ('unixnu', 'board.toml'):
        digest.update((device / name).read_bytes())
    for directory in ('package', 'scripts'):
        root = device / directory
        if not root.is_dir():
            continue
        for source in sorted(root.rglob('*')):
            if not source.is_file() or '__pycache__' in source.parts:
                continue
            digest.update(str(source.relative_to(device)).encode())
            digest.update(source.read_bytes())
    fingerprint = digest.hexdigest()
    cache = device / '.cache'
    target = cache / f'upstream-{revision[:12]}-{fingerprint[:12]}'
    if target.is_dir():
        return target
    source = source or device.parent / 'UniXNU'
    local = (source / '.git').exists()
    cache.mkdir(parents=True, exist_ok=True)

    def git(*args, cwd=None):
        subprocess.run(['git', *map(str, args)], cwd=cwd, check=True, stdout=sys.stderr)

    with tempfile.TemporaryDirectory(prefix='prepare-', dir=cache) as temporary:
        tree = Path(temporary) / 'tree'
        git('clone', '--no-checkout', '--no-hardlinks', source if local else UPSTREAM, tree)
        found = subprocess.run(['git', 'cat-file', '-e', revision + '^{commit}'], cwd=tree,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if found.returncode:
            git('fetch', UPSTREAM, revision, cwd=tree)
        git('checkout', '--detach', revision, cwd=tree)
        if (tree / '.gitmodules').is_file():
            entries = subprocess.check_output(
                ['git', 'config', '-f', '.gitmodules', '--get-regexp', r'submodule\..*\.path'],
                cwd=tree, text=True)
            for entry in entries.splitlines():
                key, path = entry.split(maxsplit=1)
                if local and (source / path / '.git').exists():
                    git('config', key.removesuffix('.path') + '.url', source / path, cwd=tree)
            git('-c', 'protocol.file.allow=always', 'submodule', 'update', '--init', '--recursive', cwd=tree)
        if patch.is_file():
            git('apply', '--check', patch, cwd=tree)
            git('apply', patch, cwd=tree)
        moved = []
        for module, revision in driver_revisions.items():
            directory = tree / 'drivers' / module
            if not directory.is_dir():
                raise ValueError('driver_revisions names an absent module: ' + module)

            def present():
                return subprocess.run(['git', 'cat-file', '-e', revision + '^{commit}'],
                                      cwd=directory, stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL).returncode == 0

            if not present():
                # A submodule clone can be shallow, and GitHub will not serve a
                # bare SHA that no ref advertises. Deepen first, then let the
                # ordinary refspec bring the history in; asking for the object
                # by name only works on a server that allows it.
                shallow = subprocess.run(['git', 'rev-parse', '--is-shallow-repository'],
                                         cwd=directory, capture_output=True,
                                         text=True).stdout.strip() == 'true'
                git('fetch', '--unshallow', 'origin', cwd=directory) if shallow \
                    else git('fetch', 'origin', cwd=directory)
            if not present():
                git('fetch', 'origin', revision, cwd=directory)
            git('checkout', '--detach', revision, cwd=directory)
            moved.append(module)
        # The engine's own `unixnu fetch` runs `git submodule update` on this
        # tree, and that follows the gitlink recorded in HEAD -- straight back
        # over the checkout above. It only skips the submodule when HEAD already
        # names the commit it is switching to; otherwise it finds the patched
        # working tree in the way and aborts ("Your local changes would be
        # overwritten"). So record the moved submodules in a commit of our own;
        # then the update has nothing to do and the patches below survive it.
        if moved:
            git('add', *('drivers/' + module for module in moved), cwd=tree)
            changed = subprocess.run(['git', 'diff', '--cached', '--quiet'],
                                     cwd=tree).returncode != 0
            if changed:
                git('-c', 'user.name=unixnu', '-c', 'user.email=unixnu@localhost',
                    'commit', '-q', '-m',
                    'pin ' + ', '.join(moved) + ' for this device', cwd=tree)
        for driver_patch, module in driver_patches:
            if driver_patch.is_file():
                git('apply', '--check', driver_patch, cwd=tree / 'drivers' / module)
                git('apply', driver_patch, cwd=tree / 'drivers' / module)
        for kit_patch, module in kit_patches:
            if kit_patch.is_file():
                git('apply', '--check', kit_patch, cwd=tree / 'kits' / module)
                git('apply', kit_patch, cwd=tree / 'kits' / module)
        tree.rename(target)
    return target


def main():
    tree = prepare()
    if sys.argv[1:] == ['--prepare']:
        print(tree)
        return
    os.environ.setdefault('UNIXNU_DEVICE', str(DEVICE))
    os.environ.setdefault('UNIXNU_OUT', str(DEVICE / 'out'))
    uefi = DEVICE.parent / 'UEFI-Pagani_SM8750'
    if uefi.is_dir():
        output = DEVICE / 'out/oneplus13t/uefi-build'
        if not os.path.lexists(uefi / 'Build'):
            output.mkdir(parents=True, exist_ok=True)
            (uefi / 'Build').symlink_to(os.path.relpath(output, uefi), target_is_directory=True)
        os.environ.setdefault('UNIXNU_UEFI', str(uefi))
        os.environ.setdefault('UNIXNU_EDK2', str(uefi / 'Mu_Basecore'))
    os.execv(sys.executable, [sys.executable, str(tree / 'unixnu'), *sys.argv[1:]])


if __name__ == '__main__':
    main()
