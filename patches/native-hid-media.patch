+// arg0 carries (down << 16) | usage, so one word is enough for press and release.
+static IOReturn mediaAction(OSObject *target,void *arg0,void *,void *,void *) {
+    NativeHidInput *self=OSDynamicCast(NativeHidInput,target);
+    if(!self)return kIOReturnBadArgument;
+    unsigned request=(unsigned)(uintptr_t)arg0;
+    return self->sendMedia((request>>16)?(request&0xffffu):0u);
+}
+extern "C" int native_hid_media_key(unsigned usage,unsigned down) {
+    NativeHidInput *device=g_mediaDevice;
+    if(!device || !usage)return -1;
+    IOWorkLoop *loop=device->getWorkLoop();
+    if(!loop)return -1;
+    unsigned request=((down?1u:0u)<<16)|(usage&0xffffu);
+    return loop->runAction(&mediaAction,device,(void *)(uintptr_t)request);
+}
