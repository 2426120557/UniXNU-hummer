# OnePlus Ace 5 Pro (hummer, SM8750) — 13T (Pagani) full-iPadOS config.
#
# 直接采用 13T 的 oneplus13t_defconfig（同 SM8750、同 21H461 kernelcache）：
# UFS 根、AES、verified root、virtio/ram block、legacy display、boot progress。
# 只多一条：force_load hummer 自己的 S3910 触屏归档（13T 是 Novatek，
# 对本机面板无效；驱动默认关闭，靠 boot arg hummer-touch=<n> 打开）。

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# SM8750 copyio 访问用户页时要临时清 PAN。
CONFIG_XNU_NATIVE_PAN=y
# BCM2837 的 panic buffer 地址在本机没有映射。
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
# OWNER_DATA_VOLUME_UUID 在构建前由真实 RAM seed 写入。
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
# CONFIG_XNU_NATIVE_ADRENO is not set   (a740 后端；hummer 是 a8xx，不适用，保持关闭)
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# Adreno 830 (a8xx) 寄存器活性探针：引擎 bsd_init 的 offline-component-load-probes.patch
# 在该 flag 下调用 native_adreno_firmware_probe()（见 package/HummerAdrenoProbe.c），
# 并由 build-xnu-4k-baseline.sh force-load build/adreno-firmware-probe/libAdrenoFirmwareProbe.a。
# 独立于上面的 NATIVE_ADRENO（a740 驱动），只打开探针钩子，不会拉入 a740 后端。
CONFIG_XNU_ADRENO_FIRMWARE_PROBE=y
CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_EARLY_BOOT_PROGRESS=y

# hummer 触屏（S3910 + drivers/NativeGeniSpi/GeniSpi.c），由
# build-hummer-touch.py 归档；默认关闭，NativeHidInput 信箱是弱引用。
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/hummer-touch/libHummerTouch.a"
