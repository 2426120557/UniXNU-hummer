# Kernel configuration of the OnePlus Ace 5 Pro (hummer, SM8750).
# Each CONFIG_XNU_<NAME> becomes XNU_<NAME> for the build scripts; {tree} in a
# string is the build tree. The shared fragments (arch/soc/os) apply first, the
# SoC one adding the SM8750 timer, PAN and panic-region settings; this file is
# applied last and therefore only lists what the board itself decides.
#
# The starting point is the 13T configuration: same SoC, same 21H461 kernelcache.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# SM8750 copyio must temporarily clear PAN when it touches user pages.
CONFIG_XNU_NATIVE_PAN=y
# The BCM2837 panic buffer address is not mapped on this device.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_ARMVIRT_PLATFORM is not set

# Read-only owner-verified root, original AMFI and SystemOS startup.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
# OWNER_DATA_VOLUME_UUID is written from the real RAM seed before the build.
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"

# Adreno 830: the backend is drivers/Adreno740 (pinned to the revision
# patches/adreno-a830.patch is cut against) plus the SM8750 platform layer in
# package/. build-hummer-adreno-kits.py produces
# build/native-adreno/libNativeAdreno.a, which this switch force-loads. The
# driver ships without a personality: package/HummerGpu.cpp drives the bring-up
# from the legacy display late probe, so nothing happens until it runs.
CONFIG_XNU_NATIVE_ADRENO=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

# Adreno 830 register liveness probe. The engine calls
# native_adreno_firmware_probe() from bsd_init under this flag and force-loads
# build/adreno-firmware-probe/libAdrenoFirmwareProbe.a. It is independent of
# NATIVE_ADRENO and only opens the hook, without pulling in the driver.
CONFIG_XNU_ADRENO_FIRMWARE_PROBE=y

CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_EARLY_BOOT_PROGRESS=y

# hummer touch (Synaptics S3910 over drivers/QcomGeniSpi), archived by
# build-hummer-touch.py. The sink in NativeHidInput is a weak reference, so the
# archive loads whether or not the touch driver is enabled by boot argument.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/hummer-touch/libHummerTouch.a"
